# ==========================================
# PRODUCTION ENVIRONMENT VARIABLES (BACKEND)
# Deploy to Render or Railway
# ==========================================

# Port for the Node.js server
PORT=10000

# The environment
NODE_ENV=production

# Supabase Credentials (from Supabase Dashboard > Settings > API)
SUPABASE_URL=https://<YOUR-PROJECT-ID>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<YOUR-SERVICE-ROLE-KEY>

# Resend Email API Key (for Invoices & Warning emails)
RESEND_API_KEY=re_...
FROM_EMAIL=billing@your-verified-domain.com
PLATFORM_ADMIN_EMAIL=you@quadem.agency

# Frontend Application URL (so backend emails link back correctly)
APP_URL=https://your-frontend-vercel-url.vercel.app

# ── Public demo / sandbox ──────────────────────────────────────
# Opt-in per environment. Unset (or anything but "true") means no demo
# tenant is created and POST /api/auth/demo-login answers 404, so the
# "Try live demo" buttons degrade to nothing rather than erroring.
#
# When enabled the server seeds a business named "Adom Superstore (Demo)"
# on first boot and rebuilds it nightly at 02:00 Accra time. Seed it by
# hand with:  npm run seed:demo   (in store-app/server)
DEMO_MODE_ENABLED=false

# The account /api/auth/demo-login signs in as. The password never leaves
# the server. Change both together, then reseed — the seeder creates the
# accounts, so an existing demo must be rebuilt for a new value to apply.
DEMO_ACCOUNT_EMAIL=demo@quaderp.app
DEMO_ACCOUNT_PASSWORD=<A-LONG-RANDOM-STRING>

# Note: Paystack keys are securely stored in the `payment_gateways` database table,
# not in the .env file!


# ==========================================
# PRODUCTION ENVIRONMENT VARIABLES (FRONTEND)
# Deploy to Vercel
# ==========================================

# The external URL of your deployed Backend API
VITE_API_URL=https://your-render-backend-url.onrender.com/api

# Supabase Credentials (Public)
VITE_SUPABASE_URL=https://<YOUR-PROJECT-ID>.supabase.co
VITE_SUPABASE_ANON_KEY=<YOUR-ANON-KEY>
