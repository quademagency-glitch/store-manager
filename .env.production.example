# ==========================================
# PRODUCTION ENVIRONMENT VARIABLES (BACKEND)
# Deploy to Render or Railway
# ==========================================

# Port for the Node.js server
PORT=10000

# The environment
NODE_ENV=production

# Supabase Credentials (from Supabase Dashboard > Settings > API)
SUPABASE_URL=https://<YOUR-PROJECT-ID>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=<YOUR-SERVICE-ROLE-KEY>

# Resend Email API Key (for Invoices & Warning emails)
RESEND_API_KEY=re_...
FROM_EMAIL=billing@your-verified-domain.com
PLATFORM_ADMIN_EMAIL=you@quadem.agency

# Frontend Application URL (so backend emails link back correctly)
APP_URL=https://your-frontend-vercel-url.vercel.app

# ── Public demo / sandbox ──────────────────────────────────────
# Opt-in per environment. Unset (or anything but "true") means no demo
# tenant is created and POST /api/auth/demo-login answers 404, so the
# "Try live demo" buttons degrade to nothing rather than erroring.
#
# When enabled the server seeds a business named "Adom Superstore (Demo)"
# on first boot and rebuilds it nightly at 02:00 Accra time. Seed it by
# hand with:  npm run seed:demo   (in store-app/server)
DEMO_MODE_ENABLED=false

# The account /api/auth/demo-login signs in as. The password never leaves
# the server. Change both together, then reseed — the seeder creates the
# accounts, so an existing demo must be rebuilt for a new value to apply.
DEMO_ACCOUNT_EMAIL=demo@quaderp.app
DEMO_ACCOUNT_PASSWORD=<A-LONG-RANDOM-STRING>

# Note: Paystack keys are securely stored in the `payment_gateways` database table,
# not in the .env file! The webhook handler reads the SECRET KEY from that table
# (Paystack signs with the secret key, not a separate webhook secret).

# ── Database migrations ────────────────────────────────────────
# A DIRECT Postgres connection string (not the pooler, not the Supabase JS
# client — neither can run DDL). Required by `npm run migrate:status` and
# `npm run migrate:up` in store-app/server. Supabase Dashboard >
# Settings > Database > Connection string > URI.
#
# This was previously missing from this file, so anyone provisioning a new
# environment from it ended up unable to run migrations at all.
DIRECT_URL=postgresql://postgres:<PASSWORD>@db.<PROJECT-ID>.supabase.co:5432/postgres

# ── Reverse proxy / client IP resolution ───────────────────────
# How many proxies sit in front of this server. MUST be a number — never
# `true`, which express-rate-limit rejects and which lets any client forge
# their own IP via X-Forwarded-For.
#
# Without this set correctly, req.ip is the proxy's address for every request,
# so every rate limiter collapses into ONE platform-wide bucket: "10 logins per
# 15 minutes" stops meaning per-user and starts meaning per-platform.
#
# The code already DEFAULTS to 2, which resolves the real client on both the
# browser path (client -> Vercel -> Railway) and the single-hop webhook path —
# verified against both header shapes. You do not need to set this unless the
# topology changes (e.g. another proxy is added, or Vercel stops fronting the
# API). To check against the live deployment, call GET /api/health/deep and
# confirm the `proxy.ip` field is a real customer address rather than a
# Vercel or Railway one. The worker also logs the resolved value at startup.
# TRUST_PROXY_HOPS=2

# ── Error monitoring (optional) ────────────────────────────────
# Entirely optional. With SENTRY_DSN unset the server never even loads the
# Sentry SDK, so behaviour is identical to not having it. Setting this one
# variable turns reporting on.
# SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>
# SENTRY_TRACES_SAMPLE_RATE=0

# ── Health check (optional) ────────────────────────────────────
# When set, GET /api/health/deep requires this value in an X-Health-Token
# header before it will return dependency timings, error strings or the proxy
# diagnostic block. Without the header callers get a bare status only.
# Leave unset to make the full payload public.
# HEALTH_CHECK_TOKEN=<A-LONG-RANDOM-STRING>

# ── HTTPS redirect escape hatch (optional) ─────────────────────
# The app 308-redirects plaintext HTTP to HTTPS in production. Both Vercel and
# Railway already do this at their edge, so it should never fire. Set to the
# string "false" to disable it without a code change if it ever misbehaves.
# FORCE_HTTPS=false

# ── Cluster ────────────────────────────────────────────────────
# Worker processes to fork. Defaults to one per CPU core.
#
# IMPORTANT: keep Railway at ONE replica unless you have verified the
# cron_runs claim table (migration 069) is working. The scheduled jobs run in
# each replica's primary process, so a second replica would run them twice —
# duplicate suspension emails, and two concurrent rebuilds of the demo tenant.
# WEB_CONCURRENCY=4

# ── API rate limiting ──────────────────────────────────────────
# Ceiling for the general /api/* limiter, per authenticated session (or per IP
# when unauthenticated). Tunable here so it can be adjusted without a deploy.
# Note it is per worker process, so the real ceiling is workers x this value.
# API_RATE_LIMIT=300


# ==========================================
# PRODUCTION ENVIRONMENT VARIABLES (FRONTEND)
# Deploy to Vercel
# ==========================================

# The external URL of your deployed Backend API.
#
# LEAVE THIS UNSET if the frontend is served by Vercel with the /api/* rewrite
# in vercel.json — the client falls back to a same-origin "/api" and the rewrite
# forwards it. Setting it to an absolute host bypasses the rewrite, and that
# host must then also appear in the `connect-src` directive of the Content
# Security Policy in vercel.json or every API call is blocked.
# VITE_API_URL=https://your-backend-host/api

# Error monitoring for the browser (optional, same deal as SENTRY_DSN above).
# With this unset the Sentry SDK is not even included in the bundle.
# VITE_SENTRY_DSN=https://<key>@<org>.ingest.sentry.io/<project>

# Supabase Credentials (Public)
VITE_SUPABASE_URL=https://<YOUR-PROJECT-ID>.supabase.co
VITE_SUPABASE_ANON_KEY=<YOUR-ANON-KEY>
