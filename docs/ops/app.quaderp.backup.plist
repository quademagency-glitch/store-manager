<?xml version="1.0" encoding="UTF-8"?>
<!--
  Daily database snapshot, scheduled by launchd.

  Install:
    1. Edit the three paths marked EDIT below.
    2. cp docs/ops/app.quaderp.backup.plist ~/Library/LaunchAgents/
    3. launchctl load ~/Library/LaunchAgents/app.quaderp.backup.plist
    4. launchctl start app.quaderp.backup        # run once now, don't wait a day
    5. Check ~/QuadERP-Backups/backup.log

  Uninstall:
    launchctl unload ~/Library/LaunchAgents/app.quaderp.backup.plist

  StartCalendarInterval rather than StartInterval: launchd runs a missed
  calendar job once when the machine next wakes, so a laptop that was shut at
  02:00 still takes its snapshot. StartInterval would simply skip it, which is
  precisely the failure this is meant to avoid.

  RunAtLoad is deliberately false. It would take a snapshot every time you log
  in, which on a laptop is many per day, and pushes the useful older ones past
  the retention window.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>app.quaderp.backup</string>

  <key>ProgramArguments</key>
  <array>
    <!-- EDIT: absolute path to the script in your checkout -->
    <string>/Volumes/QUADEM/VIBE CODING/ERP/store-app/server/scripts/backup-scheduled.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <!-- EDIT: somewhere that syncs off this machine. A snapshot sitting next
         to the database it came from does not survive the thing it exists for. -->
    <key>BACKUP_DIR</key>
    <string>/Users/CHANGEME/Library/Mobile Documents/com~apple~CloudDocs/QuadERP-Backups</string>
    <key>KEEP_DAYS</key>
    <string>14</string>
    <!-- launchd starts with a minimal PATH that has no node. Without this the
         job fails silently every night with "node: command not found". -->
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>

  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>2</integer>
    <key>Minute</key><integer>0</integer>
  </dict>

  <key>RunAtLoad</key>
  <false/>

  <!-- EDIT: stdout/stderr from launchd itself. The script keeps its own log in
       BACKUP_DIR; these two catch the failures that happen before it starts,
       which are the ones that are otherwise completely invisible. -->
  <key>StandardOutPath</key>
  <string>/tmp/quaderp-backup.out</string>
  <key>StandardErrorPath</key>
  <string>/tmp/quaderp-backup.err</string>

  <key>ProcessType</key>
  <string>Background</string>
</dict>
</plist>
