# PostHog Analytics
EXPO_PUBLIC_POSTHOG_KEY=phc_<YOUR-PROJECT-API-KEY>
EXPO_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
# Analytics does not start until this date arrives, even with the key set.
# Same gate as the web app: 30 days after the sub-processor notice goes out.
EXPO_PUBLIC_POSTHOG_START=
