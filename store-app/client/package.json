{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run check:realtime && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test:visual": "VITE_USE_MOCKS=true playwright test --project=visual",
    "test:invariants": "VITE_USE_MOCKS=true playwright test --project=invariants",
    "test:visual:full": "VITE_USE_MOCKS=true FULL_MATRIX=1 playwright test --project=visual",
    "test:visual:update": "VITE_USE_MOCKS=true playwright test --project=visual --update-snapshots",
    "test:empty": "VITE_USE_MOCKS=empty playwright test --project=invariants",
    "test:e2e": "playwright test --project=e2e",
    "check:csp": "node scripts/check-csp-hashes.mjs",
    "check:realtime": "node scripts/check-realtime-stub.mjs"
  },
  "dependencies": {
    "@sentry/react": "^10.70.0",
    "@supabase/supabase-js": "^2.106.2",
    "@tailwindcss/vite": "^4.3.0",
    "idb": "^8.0.3",
    "libphonenumber-js": "^1.13.10",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "react-hook-form": "^7.78.0",
    "react-router-dom": "^7.16.0",
    "recharts": "^3.8.1",
    "tailwindcss": "^4.3.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@sentry/vite-plugin": "^5.4.0",
    "@types/node": "^26.1.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^10.3.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.6.0",
    "vite": "^8.0.12"
  }
}
